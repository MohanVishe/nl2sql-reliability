__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Datasets are fetched, never vendored: Arcwise-Plat-SQL is CC BY-SA 4.0
# and the BIRD databases are large. See src/nl2sql_reliability/dataset.py
data/

# Raw run outputs are committed deliberately (see README), but not scratch runs:
# pilots exist to prove the harness works, not to support any claim in the write-up.
results/scratch/
results/pilot*.jsonl

# In-progress arms are ignored and committed only once complete. A partial results file
# is indistinguishable from a finished one to anyone who clones mid-run, and the numbers
# it supports would be wrong.
results/*.jsonl
!results/final/*.jsonl

.env
.DS_Store
